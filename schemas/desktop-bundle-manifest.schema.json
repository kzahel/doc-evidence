{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doc-evidence.local/schemas/desktop-bundle-manifest.schema.json",
  "title": "Doc Evidence desktop bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "version",
    "identifier",
    "platform",
    "architecture",
    "python_version",
    "frontend_sha256",
    "runtime_manifest_sha256",
    "extractor_packs",
    "components",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "doc-evidence.desktop-bundle-manifest.v1"
    },
    "product": {
      "const": "Doc Evidence"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "identifier": {
      "const": "io.github.kzahel.doc-evidence"
    },
    "platform": {
      "enum": ["macos", "windows"]
    },
    "architecture": {
      "enum": ["arm64", "x86_64"]
    },
    "python_version": {
      "type": "string",
      "pattern": "^3\\.12\\.[0-9]+$"
    },
    "frontend_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "extractor_packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pack_id", "version", "manifest_sha256"],
        "properties": {
          "pack_id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "manifest_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "platform": { "const": "macos" },
            "architecture": { "const": "arm64" }
          }
        },
        {
          "properties": {
            "platform": { "const": "windows" },
            "architecture": { "const": "x86_64" }
          }
        }
      ]
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "name",
        "version",
        "license_concluded",
        "source_url",
        "bundled_paths"
      ],
      "properties": {
        "component_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "license_concluded": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "license_files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "bundled_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "corresponding_source": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "component_id"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "component_id": { "type": "string", "minLength": 1 },
        "mach_o_architectures": {
          "type": "array",
          "items": { "enum": ["arm64", "x86_64"] },
          "uniqueItems": true
        },
        "pe_architecture": {
          "const": "x86_64"
        }
      }
    }
  }
}

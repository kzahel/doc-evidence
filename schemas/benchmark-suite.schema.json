{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/doc-evidence/benchmark-suite.schema.json",
  "title": "doc-evidence private benchmark suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "extractors", "documents"],
  "properties": {
    "schema_version": { "const": 1 },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "description": { "type": "string" },
    "extractors": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["poppler", "ocrmypdf-tesseract", "docling-standard", "marker-fast"]
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "document_class", "pages"],
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "document_class": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "path_hint": { "type": "string" },
          "pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          },
          "extractors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["poppler", "ocrmypdf-tesseract", "docling-standard", "marker-fast"]
            }
          },
          "assertions": {
            "type": "array",
            "items": { "$ref": "#/$defs/assertion" }
          }
        }
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "value", "manually_verified", "purpose"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "kind": {
          "enum": ["contains_text", "regex", "numeric_token", "page_count"]
        },
        "value": { "type": ["string", "integer"] },
        "manually_verified": { "type": "boolean" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    }
  }
}

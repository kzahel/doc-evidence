{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/doc-evidence/manifest-record.schema.json",
  "title": "doc-evidence manifest record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "content_sha256",
    "size_bytes",
    "media_type",
    "sources",
    "inventory_status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "document_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["collection_id", "path"],
        "properties": {
          "collection_id": { "type": "string" },
          "path": { "type": "string" },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "page_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "pdf_metadata": {
      "type": ["object", "null"]
    },
    "inventory_status": {
      "enum": ["ok", "unreadable", "unsupported", "error"]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "normalized_text_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/doc-evidence/manifest-record.schema.json",
  "title": "doc-evidence manifest record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "content_sha256",
    "size_bytes",
    "media_type",
    "sources",
    "inventory_status",
    "extraction_status",
    "artifact_path",
    "warnings",
    "character_count",
    "non_whitespace_character_count"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "document_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collection_id",
          "path",
          "size_bytes",
          "modified_ns",
          "observed_at"
        ],
        "properties": {
          "collection_id": { "type": "string" },
          "path": { "type": "string" },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "modified_ns": {
            "type": "integer",
            "minimum": 0
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "page_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "pdf_metadata": {
      "type": ["object", "null"]
    },
    "inventory_status": {
      "enum": ["ok", "unreadable", "unsupported", "error"]
    },
    "extraction_status": {
      "enum": [
        "embedded_text",
        "image_only",
        "not_supported_phase_1",
        "error"
      ]
    },
    "extraction_run_id": {
      "type": ["string", "null"]
    },
    "artifact_path": {
      "type": "string"
    },
    "extraction_artifact_path": {
      "type": ["string", "null"]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "normalized_text_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "character_count": {
      "type": "integer",
      "minimum": 0
    },
    "non_whitespace_character_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
